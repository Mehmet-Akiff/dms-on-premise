# ============================================================
# DMS On-Premise - .gitignore
# Node.js / Python / Docker / IDE
# ============================================================

# ---------- Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.yarn/
dist/
build/
coverage/
.env
.env.local
.env.*.local

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl
.venv/
venv/
env/
.Python
pip-log.txt
pip-delete-this-directory.txt
.mypy_cache/
.pytest_cache/
.ruff_cache/
htmlcov/

# ---------- AI / ML Models ----------
*.bin
*.pt
*.onnx
*.h5
!ai-service/models/.gitkeep

# ---------- Docker ----------
docker-compose.override.yml

# ---------- IDE ----------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---------- Uploads (runtime data) ----------
uploads/
shared-uploads/

# ---------- Logs & Runtime Data ----------
logs/
user_logs/
*.log
*.jsonl
*.sqlite
*.sqlite3
*.db

# ---------- Build Artifacts ----------
*.tar
*.exe
Output/
