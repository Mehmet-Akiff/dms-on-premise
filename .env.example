# ============================================================
# DMS On-Premise - Ortam Değişkenleri (.env)
# ============================================================

# Veritabanı Ayarları
DB_USER=dms_user
DB_PASSWORD=dms_secure_pass_2026
DB_NAME=dms_db
DB_HOST=db
DB_PORT=5432

# Güvenlik & Token Ayarları
# Lütfen canlıya alırken JWT_SECRET değerini çok güçlü bir rastgele string ile değiştirin!
JWT_SECRET=dms_secure_jwt_key_987654321_production

# Varsayılan Kullanıcı Şifreleri (İlk Çalıştırmada Kurulur)
ADMIN_DEFAULT_PASSWORD=dms_admin_password_2026!
CISO_DEFAULT_PASSWORD=dms_ciso_password_2026!
KASA_DEFAULT_PASSWORD=dms_kasa_master_password_2026!
